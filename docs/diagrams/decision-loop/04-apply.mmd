    EF -->|"崩溃或未知"| CK["对账实际对象<br/>不盲目重试"]

    style T fill:#E6F1FB,stroke:#185FA5
    style BZ fill:#E1F5EE,stroke:#0F6E56
    style EF fill:#E1F5EE,stroke:#0F6E56
    style FU fill:#F1EFE8,stroke:#888780
    style CK fill:#FAEEDA,stroke:#854F0B
