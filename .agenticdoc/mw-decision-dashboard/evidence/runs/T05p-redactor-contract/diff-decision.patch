+def _redactor_covers(redactor: object, value: str) -> bool:
+    """True only when ``redactor`` provably removes ``value`` (T05j/T05p).
+
+    A filter that raises is unusable, so it never proves coverage; a filter
+    without the ``hits`` counter is judged by whether the text changed. This is
+    the client-side counterpart of the points seam's own coverage check, so a
+    caller-owned production capture filter is verified the same way on both
+    paths.
+    """
+    if not value:
+        return True
+    try:
+        result = redactor.redact(value)  # type: ignore[attr-defined]
+    except Exception:  # noqa: BLE001 - an unusable filter never proves coverage
+        return False
+    hits = getattr(result, "hits", None)
+    if isinstance(hits, int):
+        return hits > 0
+    return getattr(result, "text", value) != value
+
