+def known_secret_superset(
+    snapshot: decision.CredentialSnapshot | None,
+) -> tuple[str, ...]:
+    """The timi leg the pre-T05j discovery still adds to this call's known set.
+
+    :func:`decision.credential_snapshot` freezes the value the transport sends.
+    When it came from the explicit ``cfg`` leg (``cfg.api_key`` /
+    ``cfg.extras["api_key"]``), the timi chain was deliberately not consulted,
+    while the book gate and the capture redactor always included it (T05e).
+    Keeping that leg makes the known set a *superset* of the frozen value and of
+    the legacy discovery - it never becomes smaller, so nothing that used to be
+    refused or redacted turns acceptable or storable because of T05j. When the
+    snapshot already came from that chain (``env`` / ``auth-json``) the frozen
+    value *is* the resolution, so nothing is resolved a second time.
+    """
+    if snapshot is None:
+        return ()
+    if getattr(snapshot, "source", "none") in ("env", "auth-json"):
+        return ()
+    try:
+        import decision_backends
+
+        value = decision_backends.resolve_timi_api_key()
+    except Exception:  # noqa: BLE001 - a missing credential never breaks the gate
+        return ()
+    return (value,) if isinstance(value, str) and value.strip() else ()
+
+
+def command_known_secret_redactor(
+    cfg: object = None, *, snapshot: decision.CredentialSnapshot | None = None
+) -> decision.KnownSecretRedactor:
+    """The known-secret set of one command/decision (T05j seam).
+
+    Same discovery as ``decision.known_secret_redactor`` (cfg values, the env
+    heuristics, Bearer/``sk-``), plus this call's frozen credential and the
+    legacy timi leg from :func:`known_secret_superset`. Shared by the CLI book
+    gate (``mw.py``) and the decision gates below, so one command cannot end up
+    with two different definitions of "this member is a secret".
+    """
+    return decision.known_secret_redactor(
+        cfg, extra_secrets=known_secret_superset(snapshot), snapshot=snapshot
+    )
