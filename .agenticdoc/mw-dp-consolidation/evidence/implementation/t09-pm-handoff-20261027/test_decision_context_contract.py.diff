+def check(book: dict, project: pathlib.Path, **kwargs) -> list:
+    options = {
+        "project_dir": project,
+        "repo_root": project,
+        "limits": GENEROUS_LIMITS,
+    }
+    options.update(kwargs)
+    return books.check_book(book, **options)
