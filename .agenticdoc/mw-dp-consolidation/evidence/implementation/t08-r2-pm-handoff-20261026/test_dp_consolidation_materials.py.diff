+    dp_id = "dp-w-type"
+    material = _material(dp_id)
+    preparation = _preparation(dp_id, material)
+
+    hit_fake = http(_ok_responder(dp_id, material))
+    hit_client = _make_client(tmp_path, monkeypatch)
