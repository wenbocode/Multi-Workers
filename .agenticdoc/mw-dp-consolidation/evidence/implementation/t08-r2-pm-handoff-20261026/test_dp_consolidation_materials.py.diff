+        dp_id,
+        material,
+        preparation,
+        actor_role=dpts.ENTRY_ROLES[dp_id],
+        logical_id="t08-bool-hit",
+        replay_check=lambda _dp, _logical: True,
+    )
+    assert hit["available"] is True
+    assert hit["replayed"] is True
+    assert hit["business_decisions"] == 0
