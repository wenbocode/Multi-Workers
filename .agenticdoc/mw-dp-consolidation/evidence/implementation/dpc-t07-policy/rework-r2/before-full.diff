+    assert check_fail.retrip is True
+    assert check_fail.brake == "engaged"
+    _verify(
+        "VC-037",
+        unauthorized_unlocks=0,
+        erased_breaker_history=int(not retrip.preserved_history),
+        reject_project_closures=0,
+        observed_retrip=int(retrip.retrip),
