+        if issues:
+            return self._prepared(
+                start,
+                dp=dp,
+                reason=REASON_INPUT_INCOMPLETE,
+                issues=issues,
+                detail=f"{len(issues)} blocking material/preparation issue(s); no request sent",
+            )
+        # 4. The one question set: entry question + prepared basis question.
+        try:
