+                dp=dp,
+                reason=REASON_ENTRY_UNAVAILABLE,
+                detail=(
+                    "decision protocol module unavailable"
+                    f" ({_PROTOCOL_IMPORT_ERROR or 'import failed'}); no request sent"
+                ),
