+API_KEY = "t08-fixture-key-0123456789"
+BUSINESS_QIDS = {
+    "dp-w-type": "triage_type",
+    "dp-pm-steer": "checkpoint_action",
+    "dp-w-check-task": "reachability",
+    "dp-QG": "qg_verdict",
+    "dp-gate-approve": "gate_decision",
+    "dp-sign-key": "q-conclusion",
+    "dp-auto": "handling",
+    "dp-route": "entry",
+}
