-/** Code-point-safe UTF-8 clamp, mirroring the Python field budgets. */
-function clampUtf8(text: string, maxBytes: number): string {
-	if (Buffer.byteLength(text, "utf8") <= maxBytes) return text;
-	let out = "";
-	let used = 0;
