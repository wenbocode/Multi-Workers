+export function triageDispatchEnvelope(input: {
+	projectDir: string;
+	dpId: string;
+	material: TriageState;
+	meta: DecisionEnvelopeMeta;
+	policy?: DecidePolicy;
+	run?: DecideRunner;
+	timeoutMs?: number;
+	maxBytes?: number;
