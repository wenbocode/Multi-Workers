+# ── Conservative tri-state liveness (mw-decision-dashboard D-001) ────────────
+#
+# ``_is_alive`` above is a two-valued probe shared by check_pid/doctor/heartbeat
+# and keeps that historical semantics. Lock-owner recovery needs the opposite
+# bias: only a probe that *proves* the process is gone may yield ``dead``;
+# anything the OS refuses to tell us is ``unknown`` (never stealable).
+
+PROCESS_ALIVE_STATES = ("alive", "dead", "unknown")
+_WIN32_ERROR_INVALID_PARAMETER = 87
+_WIN32_STILL_ACTIVE = 259
+
+
+def _win32_open_failure_state(error_code: int | None) -> str:
+    """Map an ``OpenProcess`` failure to a conservative liveness state.
+
+    ``ERROR_INVALID_PARAMETER`` (87) is how Windows reports "no such PID", so
+    it is the only mapped value that may mean dead. ``ERROR_ACCESS_DENIED`` (5:
+    another integrity level/session) and every unexpected or missing code are
+    unknown.
+    """
+    if error_code == _WIN32_ERROR_INVALID_PARAMETER:
+        return "dead"
+    return "unknown"
+
+
+def _win32_process_state(pid: int, kernel32: object | None = None) -> str:
+    """Win32 liveness via OpenProcess + GetExitCodeProcess, tri-state.
+
+    ``kernel32`` is injectable so the ACCESS_DENIED / probe-failure paths can be
+    exercised without an actual privileged owner.
+    """
+    import ctypes
+    import ctypes.wintypes
+
+    PROCESS_QUERY_LIMITED_INFORMATION = 0x1000
+    if kernel32 is None:
+        kernel32 = ctypes.windll.kernel32  # type: ignore[attr-defined]
+    handle = kernel32.OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, False, pid)
+    if not handle:
+        try:
+            error_code = int(kernel32.GetLastError())
+        except Exception:  # noqa: BLE001 - an unreadable error code proves nothing
+            return "unknown"
+        return _win32_open_failure_state(error_code)
+    try:
+        exit_code = ctypes.wintypes.DWORD()
+        if not kernel32.GetExitCodeProcess(handle, ctypes.byref(exit_code)):
+            return "unknown"
+        return "alive" if exit_code.value == _WIN32_STILL_ACTIVE else "dead"
+    finally:
+        kernel32.CloseHandle(handle)
+
+
+def _posix_process_state(pid: int) -> str:
+    """POSIX liveness: ESRCH is dead, EPERM (foreign user) is unknown."""
+    try:
+        os.kill(pid, 0)
+    except ProcessLookupError:
+        return "dead"
+    except PermissionError:
+        return "unknown"
+    except OSError:
+        return "unknown"
+    return "alive"
+
+
+def process_alive_state(pid: int) -> str:
+    """Conservatively classify a PID: ``alive`` | ``dead`` | ``unknown``.
+
+    Any unproven case - invalid pid, injected/raising probe, refused access,
+    failed ``GetExitCodeProcess`` - is ``unknown``. Callers that may move or
+    clean up state must only act on ``dead`` (D-001).
+    """
+    if isinstance(pid, bool) or not isinstance(pid, int) or pid <= 0:
+        return "unknown"
+    try:
+        if sys.platform == "win32":
+            return _win32_process_state(pid)
+        return _posix_process_state(pid)
+    except Exception:  # noqa: BLE001 - a broken probe is unknown, never dead
+        return "unknown"
+
