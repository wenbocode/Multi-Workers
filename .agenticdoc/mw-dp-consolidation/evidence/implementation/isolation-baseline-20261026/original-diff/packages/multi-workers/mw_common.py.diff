+# ── Lock owner identity (mw-decision-dashboard §9 / D-001) ────────────────────
+#
+# The monitor start lock (`.mw/decide-monitor.start.lock`) must survive a
+# crashed owner without letting a second starter steal a *live* lock. After
+# acquiring the lock the owner stamps its PID plus OS process start time into
+# the lock file; recovery may only move a lock whose owner is provably dead.
+# Everything the probes cannot prove (missing/legacy record, recycled PID,
+# unreadable file, unavailable start time) is "unknown" and must not be
+# stolen - the caller reports the conflict plus the manual recovery step.
+
+LOCK_OWNER_SCHEMA = 1
+LOCK_OWNER_STATES = ("absent", "legacy", "alive", "dead", "unknown")
+# Same order of magnitude as mw.py's serve.meta identity check (PID reuse).
+_LOCK_OWNER_START_TOLERANCE_MS = 5_000
+
+
+def process_start_ms(pid: int) -> int | None:
+    """OS-reported process start time (epoch ms), or None when unavailable.
+
+    Identity half of the lock-owner record (mirrors ``mw.process_start_ms``;
+    kept local so mw_common has no import cycle with the CLI). Windows via
+    ctypes GetProcessTimes, POSIX via /proc/<pid>/stat. Any probe failure is
+    ``None`` = unknown, never "dead".
+    """
+    if pid <= 0:
+        return None
+    if sys.platform == "win32":
+        import ctypes
+        import ctypes.wintypes
+
+        PROCESS_QUERY_LIMITED_INFORMATION = 0x1000
+        kernel32 = ctypes.windll.kernel32  # type: ignore[attr-defined]
+        handle = kernel32.OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, False, pid)
+        if not handle:
+            return None
+        try:
+            creation = ctypes.wintypes.FILETIME()
+            exit_t = ctypes.wintypes.FILETIME()
+            kernel_t = ctypes.wintypes.FILETIME()
+            user_t = ctypes.wintypes.FILETIME()
+            if not kernel32.GetProcessTimes(
+                handle,
+                ctypes.byref(creation),
+                ctypes.byref(exit_t),
+                ctypes.byref(kernel_t),
+                ctypes.byref(user_t),
+            ):
+                return None
+            ticks = (creation.dwHighDateTime << 32) | creation.dwLowDateTime
+            return ticks // 10_000 - 11_644_473_600_000  # 1601-01-01 -> epoch
+        finally:
+            kernel32.CloseHandle(handle)
+    try:
+        stat = pathlib.Path(f"/proc/{pid}/stat").read_text(encoding="utf-8")
+        after = stat.rsplit(")", 1)[1].split()
+        start_ticks = int(after[19])
+        btime = 0
+        for line in pathlib.Path("/proc/stat").read_text(encoding="utf-8").splitlines():
+            if line.startswith("btime "):
+                btime = int(line.split()[1])
+                break
+        hz = os.sysconf("SC_CLK_TCK")
+        return btime * 1000 + int(start_ticks * 1000 / hz)
+    except (OSError, ValueError, IndexError):
+        return None
+
+
+def _lock_owner_record(raw: str) -> dict | None:
+    """Parsed owner identity from raw lock bytes, or None when not a record."""
+    if raw.strip() == "":
+        return None
+    try:
+        data = json.loads(raw)
+    except ValueError:
+        return None
+    if not isinstance(data, dict) or data.get("schema") != LOCK_OWNER_SCHEMA:
+        return None
+    pid = data.get("pid")
+    if isinstance(pid, bool) or not isinstance(pid, int) or pid <= 0:
+        return None
+    start = data.get("start_ms")
+    if start is not None and (isinstance(start, bool) or not isinstance(start, int)):
+        return None
+    return {"pid": pid, "start_ms": start}
+
+
+def read_lock_owner(lock_file: pathlib.Path) -> dict | None:
+    """Owner identity recorded in a lock file, or None when absent/unreadable."""
+    try:
+        raw = pathlib.Path(lock_file).read_text(encoding="utf-8")
+    except (OSError, UnicodeDecodeError):
+        return None
+    return _lock_owner_record(raw)
+
+
+def write_lock_owner(
+    lock_file: pathlib.Path,
+    *,
+    pid: int | None = None,
+    start_ms: int | None = None,
+) -> dict:
+    """Stamp this process as the lock owner (call while holding the lock).
+
+    Refuses to create the lock file: a stamp must never resurrect a released
+    (or foreign) lock. ``start_ms`` defaults to the OS start time of ``pid``;
+    when that probe is unavailable the record keeps ``start_ms=None`` and its
+    readers degrade to state ``unknown`` (never to "stealable").
+    """
+    path = pathlib.Path(lock_file)
+    if not path.exists():
+        raise RuntimeError(
+            f"lock file {path} does not exist - acquire the lock before recording its owner"
+        )
+    owner_pid = os.getpid() if pid is None else int(pid)
+    if owner_pid <= 0:
+        raise ValueError(f"pid must be > 0, got {owner_pid}")
+    owner_start = process_start_ms(owner_pid) if start_ms is None else int(start_ms)
+    record = {
+        "schema": LOCK_OWNER_SCHEMA,
+        "pid": owner_pid,
+        "start_ms": owner_start,
+        "written_at": iso_now(),
+    }
+    path.write_text(json.dumps(record, sort_keys=True) + "\n", encoding="utf-8", newline="\n")
+    return record
+
+
+def lock_owner_state(
+    lock_file: pathlib.Path,
+    *,
+    alive_probe: Callable[[int], bool] | None = None,
+    start_ms_probe: Callable[[int], int | None] | None = None,
+    alive_state_probe: Callable[[int], str] | None = None,
+) -> dict:
+    """Classify a lock file's recorded owner: absent|legacy|alive|dead|unknown.
+
+    Returns ``{"state", "pid", "start_ms", "detail"}``. Only ``dead`` carries
+    "the recorded owner is provably gone", and even that is *evidence, not
+    permission*: recovery must re-read the identity under its own startup lock
+    and compare before moving anything. ``legacy`` (a lock file with no owner
+    record, e.g. one written by the pre-monitor protocol) and ``unknown``
+    (unreadable/garbage record, refused liveness probe, recycled PID,
+    unprobeable start time, alive but unidentifiable owner) are never stealable.
+
+    The default liveness probe is :func:`process_alive_state`, so an OS refusal
+    (Windows ``ACCESS_DENIED`` from another integrity level/session, ``EPERM``,
+    a failed ``GetExitCodeProcess``) yields ``unknown`` instead of ``dead``.
+    ``alive_probe`` keeps the older boolean injection for existing callers;
+    ``alive_state_probe`` injects the tri-state one.
+    """
+    path = pathlib.Path(lock_file)
+    if not path.exists():
+        return {"state": "absent", "pid": None, "start_ms": None, "detail": "lock file does not exist"}
+    try:
+        raw = path.read_text(encoding="utf-8")
+    except UnicodeDecodeError:
+        return {
+            "state": "unknown",
+            "pid": None,
+            "start_ms": None,
+            "detail": "lock file is not valid UTF-8 (owner unknown; do not steal)",
+        }
+    except OSError as exc:
+        return {
+            "state": "unknown",
+            "pid": None,
+            "start_ms": None,
+            "detail": f"lock file unreadable ({exc.__class__.__name__}); owner unknown; do not steal",
+        }
+    owner = _lock_owner_record(raw)
+    if owner is None:
+        if raw.strip() == "":
+            return {
+                "state": "legacy",
+                "pid": None,
+                "start_ms": None,
+                "detail": "lock file carries no owner identity (legacy lock); do not steal - confirm manually",
+            }
+        return {
+            "state": "unknown",
+            "pid": None,
+            "start_ms": None,
+            "detail": "lock file has no readable owner identity (garbage or unknown schema); do not steal",
+        }
+    pid = owner["pid"]
+    start = owner["start_ms"]
+    base = {"pid": pid, "start_ms": start}
+    if alive_probe is not None:
+        try:
+            alive_state = "alive" if alive_probe(pid) else "dead"
+        except Exception:  # noqa: BLE001 - a broken probe must not mean "stealable"
+            alive_state = "unknown"
+    else:
+        probe_alive = process_alive_state if alive_state_probe is None else alive_state_probe
+        try:
+            alive_state = probe_alive(pid)
+        except Exception:  # noqa: BLE001 - a broken probe must not mean "stealable"
+            alive_state = "unknown"
+        if alive_state not in ("alive", "dead"):
+            alive_state = "unknown"
+    if alive_state == "unknown":
+        return {
+            **base,
+            "state": "unknown",
+            "detail": (
+                f"owner PID {pid} liveness cannot be proven (probe refused/failed); "
+                "do not steal"
+            ),
+        }
+    if alive_state == "dead":
+        return {**base, "state": "dead", "detail": f"recorded owner PID {pid} is not alive"}
+    probe = process_start_ms if start_ms_probe is None else start_ms_probe
+    if start is None:
+        return {
+            **base,
+            "state": "unknown",
+            "detail": f"owner PID {pid} is alive but the record has no start identity; do not steal",
+        }
+    observed = probe(pid)
+    if observed is None:
+        return {
+            **base,
+            "state": "unknown",
+            "detail": f"owner PID {pid} is alive but its start time cannot be probed; do not steal",
+        }
+    if abs(observed - start) > _LOCK_OWNER_START_TOLERANCE_MS:
+        return {
+            **base,
+            "state": "unknown",
+            "detail": f"PID {pid} is alive but its start identity differs from the record (PID reuse); do not steal",
+        }
+    return {**base, "state": "alive", "detail": f"owner PID {pid} is the recorded process"}
+
