+# ── Control-root resolution (mw-decision-dashboard §3.1 / D-002) ──────────────
+
+# Where a resolved control root came from. "refused" means "no control
+# evidence was accepted": the caller's path is returned unchanged and must
+# never be used to write a shared archive (require_control=False only).
+_CONTROL_ROOT_SOURCES = ("project", "agenticdoc", "key", "target-root", "refused")
+_CONTROL_ROOT_ERROR_CODES = {"not-control": "E-ROOT-NOT-CONTROL", "ambiguous-root": "E-ROOT-AMBIGUOUS"}
+# How far above the given path a `target.yml`-declared control may be found.
+# Deliberately shallow: an independent game/partition root must be handed its
+# control root explicitly, never discovered by a deep upward search (§3.1).
+_CONTROL_ROOT_MAX_UP = 2
+
+
+class ControlRootError(RuntimeError):
+    """Fail-closed control-root refusal (never a guessed/second archive root)."""
+
+    def __init__(self, kind: str, message: str) -> None:
+        super().__init__(f"{_CONTROL_ROOT_ERROR_CODES[kind]}: {message}")
+        self.kind = kind
+
+
+def _canonical_root(path: pathlib.Path | str) -> pathlib.Path:
+    """Absolute, junction/symlink-resolved form used for root identity."""
+    return pathlib.Path(os.path.realpath(os.path.abspath(os.path.expanduser(str(path)))))
+
+
+def _root_key(path: pathlib.Path | str) -> str:
+    return os.path.normcase(os.path.normpath(str(path)))
+
+
+def _root_contains(parent: pathlib.Path | str, child: pathlib.Path | str) -> bool:
+    """True when child is parent or inside it (case-insensitive on Windows)."""
+    p = _root_key(parent)
+    c = _root_key(child)
+    return c == p or c.startswith(p.rstrip("\\/") + os.sep)
+
+
+def _control_shape_evidence(path: pathlib.Path) -> list[tuple[pathlib.Path, str]]:
+    """Evidence carried by the path itself: project / .agenticdoc / key shapes."""
+    out: list[tuple[pathlib.Path, str]] = []
+    if path.name == ".agenticdoc":
+        out.append((path.parent, "agenticdoc"))
+    if path.parent.name == ".agenticdoc":
+        out.append((path.parent.parent, "key"))
+    if (path / ".agenticdoc").is_dir():
+        out.append((path, "project"))
+    return out
+
+
+def _control_target_evidence(path: pathlib.Path) -> list[tuple[pathlib.Path, str]]:
+    """Evidence from `<ancestor>/.agenticdoc/target.yml`, at most 2 levels up.
+
+    A candidate counts only when the given path is the declared control root,
+    its resolved workspace root, or inside either of them. Unreadable or
+    contradictory target config propagates TargetConfigError (fail-closed -
+    never a silent fallback to single).
+    """
+    ancestors = [path]
+    ancestor = path
+    for _ in range(_CONTROL_ROOT_MAX_UP):
+        ancestor = ancestor.parent
+        ancestors.append(ancestor)
+    evidence: list[tuple[pathlib.Path, str]] = []
+    seen: set[str] = set()
+    for candidate in ancestors:
+        key = _root_key(candidate)
+        if key in seen:
+            continue
+        seen.add(key)
+        if not (candidate / ".agenticdoc" / "target.yml").is_file():
+            continue
+        config = load_target_config(candidate)
+        control = pathlib.Path(config["control_root"])
+        workspace = pathlib.Path(workspace_root(config))
+        if _root_contains(control, path) or _root_contains(workspace, path):
+            evidence.append((control, "target-root"))
+    return evidence
+
+
+def resolve_control_root(
+    project_dir: pathlib.Path | str,
+    *,
+    require_control: bool = True,
+) -> tuple[pathlib.Path, str]:
+    """Resolve the single control root that owns ``project_dir``.
+
+    Accepted evidence (§3.1): the canonical project/.agenticdoc/key shapes plus
+    a shallow (<= 2 levels) `target.yml` probe that only counts when the path is
+    a declared control root, its workspace root, or inside one. There is no
+    cwd/env/HTTP input and nothing is ever created.
+
+    Returns ``(control_root, source)`` with source in
+    :data:`_CONTROL_ROOT_SOURCES`. Raises ControlRootError(kind ``not-control``)
+    when no control evidence exists and ``require_control`` is true, and
+    ControlRootError(kind ``ambiguous-root``) whenever two distinct controls can
+    claim the path (e.g. a stray `.agenticdoc` below a control-declared game
+    root) - refusing beats creating a second archive tree. TargetConfigError
+    from a probed target.yml propagates unchanged.
+
+    With ``require_control=False`` an unsupported path resolves to itself with
+    source ``refused`` so read-only work can continue, but that root must never
+    be used for shared-archive writes.
+    """
+    path = _canonical_root(project_dir)
+    evidence = _control_shape_evidence(path)
+    evidence.extend(_control_target_evidence(path))
