+    controls: dict[str, pathlib.Path] = {}
+    sources: dict[str, str] = {}
+    for control, source in evidence:
+        key = _root_key(control)
+        controls.setdefault(key, control)
+        # Shape evidence names the relationship the caller used; keep it over
+        # the generic "target-root" label when both agree on the same root.
+        if key not in sources or sources[key] == "target-root":
+            sources[key] = source
+
+    if len(controls) > 1:
+        listed = ", ".join(sorted(str(c) for c in controls.values()))
+        raise ControlRootError(
+            "ambiguous-root",
+            f"{path} is claimed by more than one control root ({listed}); "
+            "pass the control root explicitly instead of a workspace/mapped root",
+        )
+    if controls:
+        key = next(iter(controls))
+        return controls[key], sources[key]
+    if require_control:
+        raise ControlRootError(
+            "not-control",
+            f"{path} carries no control evidence (no .agenticdoc, no target.yml within "
+            f"{_CONTROL_ROOT_MAX_UP} levels); refusing to guess a control root",
+        )
+    return path, "refused"
+
