    def test_case_prepared_at_is_a_recorded_past_instant_with_explicit_zone():
        """``preparation.prepared_at`` is a frozen, recorded instant in the past.
    
        The eight synthetic cases were prepared at the instant recorded in the T05-R2
        evidence (explicit ``+00:00``); the constant is frozen so regeneration is
        byte-stable. It is the authoring instant of this *synthetic fixture set*, not
        evidence that a real decision was prepared or authorized. A future value can
        never describe a preparation that already happened, and a per-run clock read
        would drift on every regeneration.
        """
        # Local import: this block is appended so the 28 shipped test functions keep
        # their exact lines/AST (`ast.get_source_segment` stays byte-identical).
        from datetime import datetime, timedelta, timezone
    
        module = _generator_module()
        source = GENERATOR_PATH.read_text(encoding="utf-8")
        assert "datetime.now(" not in source and "time.time(" not in source, (
            "the case generator must never read the wall clock: the shipped bytes would "
            "drift on every regeneration"
        )
        recorded = module.CASE_PREPARED_AT
        prepared = datetime.fromisoformat(recorded)
        assert prepared.tzinfo is not None, f"{recorded}: an instant without a zone is a guess"
        assert prepared.utcoffset() == timedelta(0), recorded
        assert recorded.endswith("+00:00"), f"{recorded}: the zone must be explicit in the text"
