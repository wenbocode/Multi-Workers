+def test_prepared_request_refuses_a_missing_or_non_eligible_role(entry_id: str) -> None:
+    """The prepared request needs a real role; omission is never an exemption.
+
+    Role is the request's eligibility input (bound actor), not a self-report:
+    an absent, empty, unknown or cross-role value is refused for every entry,
+    while the legal per-entry role keeps passing (previous test).
+    """
+    material = _material(entry_id)
+    preparation = _preparation(entry_id, material)
+    choice = dpts.resolve_entry_choices(entry_id, material)[0]
+    wrong = "worker" if dpts.ENTRY_ROLES[entry_id] == "pm" else "pm"
+    for role in (None, "", "   ", "agent", "human", "system", wrong):
+        issues = dpts.prepared_request_issues(
+            entry_id,
+            material,
+            preparation,
+            actor_role=role,
+            choice=choice,
+            basis_id="b-primary",
+        )
+        assert [path for path, _detail in issues] == ["actor_role"], (entry_id, role, issues)
+        assert issues[0][1].strip(), (entry_id, role)
+    # Omitting the parameter entirely is the same absence, not a silent skip.
+    issues = dpts.prepared_request_issues(
+        entry_id, material, preparation, choice=choice, basis_id="b-primary"
+    )
+    assert [path for path, _detail in issues] == ["actor_role"], (entry_id, issues)
+
