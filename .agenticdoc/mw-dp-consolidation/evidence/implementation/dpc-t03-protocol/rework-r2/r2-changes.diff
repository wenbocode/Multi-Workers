+@pytest.mark.parametrize("entry_id", dpts.ACTIVE_DP_IDS)
+def test_preparation_refuses_a_prepared_at_outside_the_iso_contract(entry_id: str) -> None:
+    """``prepared_at`` is the pre-submission time, so it must be a real ISO stamp.
+
+    Same contract as the package's task-state observations: an ISO-8601 timestamp
+    that carries an explicit offset (``Z``/``+hh:mm``). A non-string, a blank
+    value, free text, a bare date or an offset-less local time is refused; a
+    legal UTC/offset stamp keeps the preparation complete.
+    """
+    material = _material(entry_id)
+    preparation = _preparation(entry_id, material)
+    assert dpts.preparation_issues(entry_id, preparation, material) == ()
+    for bad in (
+        "not-an-ISO-timestamp",
+        "",
+        "   ",
+        17,
+        True,
+        None,
+        ["2026-10-26T00:00:00Z"],
+        "2026-10-26",
+        "2026-10-26T00:00:00",
+        "2026-10-26 00:00:00Z",
+        "2026-13-26T00:00:00Z",
+    ):
+        broken = dict(preparation, prepared_at=bad)
+        issues = dpts.preparation_issues(entry_id, broken, material)
+        assert [path for path, _detail in issues] == ["prepared_at"], (entry_id, bad, issues)
+    for legal in (
+        "2026-10-26T00:00:00Z",
+        "2026-10-26T00:00:00+00:00",
+        "2026-10-26T08:00:00+08:00",
+        "2026-10-26T00:00:00.123456Z",
+    ):
+        good = dict(preparation, prepared_at=legal)
+        assert dpts.preparation_issues(entry_id, good, material) == (), (entry_id, legal)
+    missing = dict(preparation)
+    missing.pop("prepared_at")
+    issues = dpts.preparation_issues(entry_id, missing, material)
+    assert [path for path, _detail in issues] == ["prepared_at"], (entry_id, issues)
+
+
