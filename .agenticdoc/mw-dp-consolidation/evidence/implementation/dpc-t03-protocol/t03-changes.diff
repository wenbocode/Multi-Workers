+        "question_types",
+        "preparation",
+        "points",
+        "retired",
+    }
+    assert [record["id"] for record in doc["retired"]] == list(OLD_IDS_25)
+    assert not set(point["id"] for point in doc["points"]) & set(
+        record["id"] for record in doc["retired"]
