+        _refuse(
+            "prepared_at",
+            "must be the preparation's recorded prepared_at; the write clock is not a preparation time",
+        )
+    catalog = preparation.get("basis_catalog")
+    selected = next(
+        (
+            item
+            for item in catalog
+            if isinstance(item, Mapping) and item.get("id") == fields["basis_id"]
+        ),
+        None,
+    )
