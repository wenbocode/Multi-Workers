            store,
            meta,
            decision_id=decision_id,
            dp=DP,
            outcome="ok",
            task_after=_state(
                "done", source="dispatch-result", observed_at="2026-10-27T10:00:00+00:00"
            ),
        ).recorded is True
        before_bytes = _raw(store)
    
