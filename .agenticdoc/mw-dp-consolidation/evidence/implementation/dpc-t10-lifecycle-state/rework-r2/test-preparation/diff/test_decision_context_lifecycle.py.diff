+@pytest.mark.parametrize(
+    "material,choice",
+    [
+        ({"question": "which prepared handling option applies now?"}, "c-ghost"),
+        (_auto_material([_auto_candidate("c-one", "the only option")]), "c-one"),
+    ],
+    ids=["no-handling-options", "single-candidate-set"],
