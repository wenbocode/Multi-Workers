    def _recorded_after_floor(
        store: "LifecycleStore", meta: "DecisionMeta", task_after: dict[str, object]
    ) -> None:
        """Refuse a new after observation that precedes one already recorded.
    
        ``executed``/``settled`` follow the same non-decreasing rule the task
        terminal already enforces: the creation fact's before is the floor, and so is
        every earlier ``task_after`` of the same logical record. The association is
        proven by :func:`_ledger_facts`, so another task's after snapshot is never
        borrowed and an unrecorded (``None``) axis is never guessed. The caller runs
