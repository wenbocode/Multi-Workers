+def _dynamic_entry_answer_issues(
+    dp_id: str, material: Mapping[str, object] | None, choice: object
+) -> tuple[tuple[str, str], ...]:
+    """The prepared answer space of the one dynamic entry (single source).
+
+    Only ``dp-auto`` has a PM-prepared candidate set; a fixed/route entry keeps
+    its frozen enum and is neither widened nor narrowed here. Both checks come
+    from :mod:`decision_points` (``entry_choice_issues`` resolves the legal ids,
+    ``entry_material_issues`` owns the candidate-set contract): a missing or
+    illegal set fails closed instead of legalising an invented choice, and an
+    empty legal set is never "nothing to check".
+    """
+    if decision_points.require_active_dp(dp_id).kind != "dynamic-candidates":
+        return ()
+    return decision_points.entry_choice_issues(dp_id, choice, material) + decision_points.entry_material_issues(
+        dp_id, material
+    )
+
+
+def _refuse_entry_issues(
+    store: "LifecycleStore", issues: tuple[tuple[str, str], ...]
+) -> None:
+    """Raise the first entry-contract issue, never echoing unproven text.
+
+    An issue's detail can name caller-chosen keys (candidate ids/labels are
+    prepared input), so it passes the injected redactor exactly like the
+    preparation authority's messages do.
+    """
+    if not issues:
+        return
+    name, rule = issues[0]
+    if store.redact is not None and store.redact.redact(rule).hits:
+        rule = "does not satisfy the entry's prepared answer contract; the value is withheld"
+    _refuse(name, rule)
+
+
