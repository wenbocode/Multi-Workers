+def _recorded_after_floor(
+    store: "LifecycleStore", meta: "DecisionMeta", task_after: dict[str, object]
+) -> None:
+    """Refuse a new after observation that precedes one already recorded.
+
+    ``executed``/``settled`` follow the same non-decreasing rule the task
+    terminal already enforces: the creation fact's before is the floor, and so is
+    every earlier ``task_after`` of the same logical record. The association is
+    proven by :func:`_ledger_facts`, so another task's after snapshot is never
+    borrowed and an unrecorded (``None``) axis is never guessed. The caller runs
+    this before the write and again inside the append lock, where the rows can no
+    longer change between the check and the append.
+    """
+    start, events = _ledger_facts(store, meta)
+    try:
+        stored_before = decision_task_state.validate_task_state(start.get("task_before"))
+        decision_task_state.validate_observation_order(stored_before, task_after)
+        for row in events:
+            if row.get("logical_id") != meta.logical_id:
+                continue
+            prior = decision_task_state.validate_task_state(row.get("task_after"))
+            if prior is not None:
+                decision_task_state.validate_observation_order(prior, task_after)
+    except decision_task_state.TaskStateInputError as exc:
+        raise LifecycleInputError(str(exc)) from None
+
