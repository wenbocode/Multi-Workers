+def _canonical_json(value: object) -> str:
+    """One canonical serialisation (stable key order, no NaN, UTF-8 text)."""
+    return json.dumps(
+        value, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False
+    )
+
