+    assert json.loads(receipt.read_text(encoding="utf-8"))["input_diagnostics"] == diagnostics
+    rc, second, _ = _invoke("run", tmp_path, monkeypatch, **opts)
+    assert rc == 0
+    replay = _payload(second)
+    assert not replay["available"] and replay["replayed"]
